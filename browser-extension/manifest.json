{
  "manifest_version": 3,
  "name": "LuzCrawl",
  "version": "3.3.0",
  "description": "用真实浏览器搜索、采集网页并保存 HTML 与媒体证据。",
  "permissions": [
    "debugger",
    "tabs",
    "cookies",
    "activeTab",
    "alarms",
    "storage",
    "tabGroups",
    "downloads",
    "downloads.ui",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LuzCrawl",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "short_name": "LuzCrawl",
  "version_name": "LuzCrawl 3.3.0 (real-browser search)"
}
